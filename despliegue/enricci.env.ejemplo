# Configuración del sitio en el servidor.
#
# Va en /etc/enricci/enricci.env con permisos 640 (root:enricci). Tiene
# contraseñas: NO se versiona ni se copia al repositorio.
#
#   sudo install -m 640 -o root -g enricci enricci.env.ejemplo /etc/enricci/enricci.env
#   sudo nano /etc/enricci/enricci.env
#
# El doble guión bajo es cómo .NET representa el ":" de la configuración:
# "Sitio__Dominio" es lo mismo que la clave "Sitio:Dominio" de appsettings.json.

# --- Dónde viven los datos ----------------------------------------------------
# Fuera de la carpeta de la aplicación, para que el despliegue no los pise.
ConnectionStrings__Enricci=Data Source=/var/lib/enricci/enricci.db
Respaldo__Carpeta=/var/lib/enricci/respaldos

# Claves con las que se firman la cookie de sesión y el token antiforgery. Si
# esta carpeta se pierde, se cierran todas las sesiones del panel.
Hosting__CarpetaDeClaves=/var/lib/enricci/claves

# --- El sitio corre detrás de nginx -------------------------------------------
# Sin esto, las URL canónicas saldrían con http:// y el freno anti fuerza bruta
# de la pantalla de ingreso vería a todos los visitantes como una sola IP.
Hosting__DetrasDeProxy=true

# --- Dominio ------------------------------------------------------------------
# Dejar VACÍO hasta que el dominio resuelva de verdad. Con el dominio puesto, el
# sitio arma todas las URL absolutas con él aunque se entre por la IP: si el
# dominio todavía no existe, los enlaces que se comparten por WhatsApp apuntan a
# la nada y la imagen de la publicación no se ve.
#
# No hace falta escribirlo a mano: `despliegue/dominio.sh` lo deja puesto cuando
# configura el dominio y su certificado.
Sitio__Dominio=

# Acotar a qué nombres responde el sitio. Descomentar SÓLO cuando el dominio ya
# esté andando: si el proxy reenvía otro nombre, el sitio contesta 400 a todo.
# Los cuatro nombres: el principal, el alias y los www de cada uno. Los alias
# entran porque nginx les responde con un 301, y para poder redirigir primero
# tiene que dejar pasar el pedido.
# AllowedHosts=enriccipropiedades.com;www.enriccipropiedades.com;enriccipropiedades.com.ar;www.enriccipropiedades.com.ar

# --- Aviso por correo de las consultas ----------------------------------------
# Las consultas se guardan en la base igual; esto es sólo el aviso.
# Con Gmail hace falta una "contraseña de aplicación", no la del correo, y tener
# la verificación en dos pasos activada.
Correo__Habilitado=true
Correo__Servidor=smtp.gmail.com
Correo__Puerto=587
Correo__UsarSsl=true
Correo__Usuario=
Correo__Clave=
Correo__Remitente=
Correo__Destinatario=horacioenricci@gmail.com

# --- Usuario del panel --------------------------------------------------------
# Dejar vacío: en el primer arranque se genera una contraseña al azar y se
# escribe una única vez en el registro (sudo journalctl -u enricci | grep -i contraseña).
# Hay que anotarla en ese momento; después sólo queda su hash en la base.
Admin__ClaveInicial=

# Otras personas con acceso al panel, separadas por punto y coma. En cada
# arranque se da de alta a las que falten, con una contraseña al azar que se
# escribe una única vez en el registro, igual que la del primer usuario:
#
#   sudo journalctl -u enricci | grep -i "contraseña"
#
# A las que ya existen no las toca. Para sacarle el acceso a alguien, no
# alcanza con borrarlo de acá: hay que desactivar al usuario desde el panel.
Admin__Adicionales=

# --- Calculadora de gastos de escrituración -----------------------------------
# Nace APAGADA y así tiene que quedarse hasta que los porcentajes estén
# confirmados por la inmobiliaria. Los fija la Ciudad, el colegio de escribanos
# y cada operación, cambian con el tiempo y admiten excepciones (vivienda única,
# montos exentos, crédito hipotecario). Un número equivocado publicado acá no es
# un error de cálculo: es una promesa que después hay que sostener.
#
# Mientras esté en false, la página /gastos-de-escrituracion redirige a Servicios,
# no aparece ningún enlace hacia ella y no figura en el mapa del sitio.
#
# Para encenderla: poner true y cargar los conceptos. El número entre guiones
# bajos es la posición en la lista, empezando por el cero, y tiene que ser
# correlativo: si falta el 1, los que siguen se pierden.
#
#   Escritura__Habilitada=true
#   Escritura__Vigencia=agosto de 2026
#   Escritura__Nota=Consultanos el caso concreto antes de reservar.
#
#   Escritura__Conceptos__0__Nombre=Impuesto de sellos
#   Escritura__Conceptos__0__Porcentaje=0
#   Escritura__Conceptos__0__Paga=Ambos
#   Escritura__Conceptos__0__Detalle=Tributo de la Ciudad sobre el valor de la operación.
#
#   Escritura__Conceptos__1__Nombre=Honorarios del escribano
#   Escritura__Conceptos__1__Porcentaje=0
#   Escritura__Conceptos__1__Paga=Comprador
#
# Porcentaje va sobre el precio. Para los gastos que no dependen del valor de la
# propiedad —informes, certificaciones— se usa Fijo, en dólares:
#
#   Escritura__Conceptos__2__Fijo=0
#
# Paga acepta Comprador, Vendedor o Ambos. "Ambos" se muestra repartido por mitades.
Escritura__Habilitada=false

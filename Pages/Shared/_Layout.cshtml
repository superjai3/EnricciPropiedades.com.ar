@inject Enricci_Propiedades.Services.RetratoTitular Retrato
@inject Microsoft.Extensions.Options.IOptions<OpcionesSitio> OpcionesDelSitio
@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string? Activo(string ruta) =>
        paginaActual.Equals(ruta, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    var titulo = ViewData["Title"] as string;
    var urlBase = OpcionesDelSitio.Value.UrlBase(Context.Request);
    var urlCanonica = urlBase + Context.Request.Path;

    // Imagen para redes: cada página puede poner la suya (la ficha manda la
    // foto de la propiedad). Sin eso se usa la tarjeta de marca, dibujada a
    // 1200x630 —la medida que esperan WhatsApp, Facebook y LinkedIn— con el
    // isotipo, el nombre y el dominio.
    var imagenSocial = ViewData["OgImagen"] as string;
    var esTarjetaDeMarca = imagenSocial is null;
    var urlImagen = urlBase + (imagenSocial ?? "/imagenes/compartir.jpg");
    var tipoOg = ViewData["OgTipo"] as string ?? "website";
    var descripcion = ViewData["Descripcion"] as string
        ?? "Inmobiliaria en la Ciudad de Buenos Aires desde 1932. Venta y alquiler de propiedades, tasaciones, administración de cobranzas y asesoría legal en Monserrat, Constitución, San Cristóbal y alrededores.";
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(string.IsNullOrEmpty(titulo) ? SitioInfo.Nombre + " · Inmobiliaria en CABA" : titulo + " · " + SitioInfo.NombreCorto)</title>
    <meta name="description" content="@descripcion" />
    <meta name="theme-color" content="#F5333F" />
    <meta name="author" content="@SitioInfo.Nombre" />

    <meta property="og:type" content="@tipoOg" />
    <meta property="og:site_name" content="@SitioInfo.Nombre" />
    <meta property="og:title" content="@(titulo ?? SitioInfo.Nombre)" />
    <meta property="og:description" content="@descripcion" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagen" />
    <meta property="og:image:alt" content="@SitioInfo.Nombre — inmobiliaria en la Ciudad de Buenos Aires desde @SitioInfo.AnioFundacion" />
@if (esTarjetaDeMarca)
{
    @* Declarar la medida evita que WhatsApp muestre el enlace sin imagen
       mientras la descarga: con el tamaño a la vista la reserva de entrada. *@
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
}
    <meta name="twitter:card" content="summary_large_image" />

    @* Permite a Google usar la miniatura grande y el texto completo en los
       resultados y en los resúmenes con IA. Sin esto recorta ambos. *@
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href="@urlCanonica" />

    @* El isotipo es lo que se ve en la pestaña, al lado del dominio, y al
       guardar el sitio en la pantalla de inicio del teléfono. *@
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    @* Las dos variantes con las que se pinta casi todo el texto. Se piden antes
       de que el navegador termine de leer el CSS, que es donde recién se
       enteraría de que las necesita. *@
    <link rel="preload" href="~/fonts/web/vietnam-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/web/vietnam-extrabold.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="~/css/enricci.css" asp-append-version="true" />

    <script nonce="@Context.Nonce()">
        // Aplica el tema guardado antes de pintar, para evitar el destello blanco.
        (function () {
            // Marca que hay JavaScript: sin esta clase el contenido animado se ve siempre.
            document.documentElement.classList.add('js');
            try {
                var t = localStorage.getItem('enricci-tema');
                if (t === 'oscuro' || t === 'claro') {
                    document.documentElement.setAttribute('data-tema', t);
                }
            } catch (e) { }
        })();
    </script>

    @* Quién es la inmobiliaria y qué es este sitio, en el vocabulario de
       schema.org. Se arma en Services/DatosEstructurados.cs a partir de
       SitioInfo, así lo que se declara y lo que se muestra salen del mismo dato. *@
    <script type="application/ld+json" nonce="@Context.Nonce()">
        @Html.Raw(Enricci_Propiedades.Services.DatosEstructurados.Grafo(urlBase, descripcion, Retrato.Hay))
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="saltar-a-contenido" href="#contenido">Saltar al contenido</a>
    <partial name="_Iconos" />

    <header class="barra">
        <div class="contenedor">
            <a class="marca" asp-page="/Index" aria-label="@SitioInfo.Nombre, inicio">
                <img class="marca__logo" src="~/imagenes/isologo.png" alt="" width="40" height="40" />
                <span class="marca__texto">
                    <span class="marca__nombre">R. H. <em>Enricci</em> <span class="marca__cola">Propiedades</span></span>
                    <span class="marca__bajada">Inmobiliaria</span>
                </span>
            </a>

            <nav aria-label="Navegación principal">
                <ul class="menu">
                    <li class="menu__item">
                        <a class="menu__enlace" asp-page="/Index" aria-current="@Activo("/Index")">Inicio</a>
                    </li>
                    <li class="menu__item">
                        <a class="menu__enlace" asp-page="/Quienes_Somos" aria-current="@Activo("/Quienes_Somos")">
                            La empresa
                            <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                        </a>
                        <ul class="submenu">
                            <li>
                                <a asp-page="/Quienes_Somos">Quiénes somos<small>Tres generaciones en el barrio</small></a>
                            </li>
                            <li>
                                <a asp-page="/Mision">Misión<small>Para qué trabajamos</small></a>
                            </li>
                            <li>
                                <a asp-page="/Vision">Visión<small>Hacia dónde vamos</small></a>
                            </li>
                        </ul>
                    </li>
                    <li class="menu__item">
                        <a class="menu__enlace" asp-page="/Servicios" aria-current="@Activo("/Servicios")">
                            Servicios
                            <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                        </a>
                        <ul class="submenu">
                            <li><a asp-page="/Tasacion">Tasación<small>Valor real de mercado en 48 h</small></a></li>
                            <li><a asp-page="/Cobranza">Administración y cobranza<small>Alquileres cobrados a término</small></a></li>
                            <li><a asp-page="/Asesoria_Legal">Asesoría legal<small>Escrituras, contratos y sucesiones</small></a></li>
                        </ul>
                    </li>
                    <li class="menu__item">
                        <a class="menu__enlace" asp-page="/Propiedades" aria-current="@Activo("/Propiedades")">
                            Propiedades
                            <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                        </a>
                        <ul class="submenu">
                            <li><a asp-page="/Propiedades" asp-route-operacion="Venta">Venta<small>Departamentos, casas y PH</small></a></li>
                            <li><a asp-page="/Propiedades" asp-route-operacion="Alquiler">Alquiler<small>Vivienda y locales</small></a></li>
                            <li><a asp-page="/Propiedades" asp-route-operacion="AlquilerTemporario">Alquiler temporario<small>Estadías desde un mes</small></a></li>
                            <li><a asp-page="/Propiedades" asp-route-tipo="LocalComercial">Locales comerciales<small>A la calle y en galería</small></a></li>
                            <li><a asp-page="/Propiedades" asp-route-tipo="FondoDeComercio">Fondos de comercio<small>Negocios en marcha</small></a></li>
                            <li><a asp-page="/Propiedades" asp-route-tipo="Cochera">Cocheras<small>Fijas y cubiertas</small></a></li>
                        </ul>
                    </li>
                    <li class="menu__item">
                        <a class="menu__enlace" asp-page="/Contacto" aria-current="@Activo("/Contacto")">Contacto</a>
                    </li>
                </ul>
            </nav>

            <div class="barra__acciones">
                <button class="tema-btn" type="button" data-accion="tema" aria-label="Cambiar entre tema claro y oscuro">
                    <svg class="icono-sol" aria-hidden="true"><use href="#i-sol" /></svg>
                    <svg class="icono-luna" aria-hidden="true"><use href="#i-luna" /></svg>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="barra__admin barra__admin--activo" asp-page="/Admin/Index"
                       title="Ir al panel de administración">
                        <svg aria-hidden="true"><use href="#i-llave" /></svg>
                        <span>Panel</span>
                    </a>
                }
                else
                {
                    <a class="barra__admin" asp-page="/Admin/Ingresar" rel="nofollow"
                       title="Acceso para la administración del sitio">
                        <svg aria-hidden="true"><use href="#i-llave" /></svg>
                        <span>Administrar</span>
                    </a>
                }

                <a class="btn btn--sm" asp-page="/Tasacion">
                    Tasar mi propiedad
                    <svg aria-hidden="true"><use href="#i-flecha" /></svg>
                </a>
                <button class="hamburguesa" type="button" aria-expanded="false" aria-controls="panel-movil" aria-label="Abrir menú">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="panel-movil" id="panel-movil">
        <div class="contenedor">
            <ul>
                <li class="panel-movil__grupo">
                    <a class="panel-movil__cabeza" asp-page="/Index">Inicio</a>
                </li>
                <li class="panel-movil__grupo">
                    <button class="panel-movil__cabeza" type="button" data-desplegable aria-expanded="false">
                        La empresa
                        <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                    </button>
                    <div class="panel-movil__sub">
                        <div>
                            <a asp-page="/Quienes_Somos">Quiénes somos</a>
                            <a asp-page="/Mision">Misión</a>
                            <a asp-page="/Vision">Visión</a>
                        </div>
                    </div>
                </li>
                <li class="panel-movil__grupo">
                    <button class="panel-movil__cabeza" type="button" data-desplegable aria-expanded="false">
                        Servicios
                        <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                    </button>
                    <div class="panel-movil__sub">
                        <div>
                            <a asp-page="/Servicios">Todos los servicios</a>
                            <a asp-page="/Tasacion">Tasación</a>
                            <a asp-page="/Cobranza">Administración y cobranza</a>
                            <a asp-page="/Asesoria_Legal">Asesoría legal</a>
                        </div>
                    </div>
                </li>
                <li class="panel-movil__grupo">
                    <button class="panel-movil__cabeza" type="button" data-desplegable aria-expanded="false">
                        Propiedades
                        <svg class="chevron" aria-hidden="true"><use href="#i-chevron" /></svg>
                    </button>
                    <div class="panel-movil__sub">
                        <div>
                            <a asp-page="/Propiedades">Ver todas</a>
                            <a asp-page="/Propiedades" asp-route-operacion="Venta">Venta</a>
                            <a asp-page="/Propiedades" asp-route-operacion="Alquiler">Alquiler</a>
                            <a asp-page="/Propiedades" asp-route-operacion="AlquilerTemporario">Alquiler temporario</a>
                            <a asp-page="/Propiedades" asp-route-tipo="LocalComercial">Locales comerciales</a>
                            <a asp-page="/Propiedades" asp-route-tipo="FondoDeComercio">Fondos de comercio</a>
                            <a asp-page="/Propiedades" asp-route-tipo="Cochera">Cocheras</a>
                        </div>
                    </div>
                </li>
                <li class="panel-movil__grupo">
                    <a class="panel-movil__cabeza" asp-page="/Contacto">Contacto</a>
                </li>
            </ul>
            <div class="panel-movil__pie">
                <a class="btn btn--bloque" asp-page="/Tasacion">Tasar mi propiedad</a>
                <a class="btn btn--fantasma btn--bloque" href="@SitioInfo.TelefonoLink">Llamar al @SitioInfo.Telefono</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn--fantasma btn--bloque" asp-page="/Admin/Index">Panel de administración</a>
                }
                else
                {
                    <a class="btn btn--fantasma btn--bloque" asp-page="/Admin/Ingresar" rel="nofollow">Administrar el sitio</a>
                }
            </div>
        </div>
    </div>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="contenedor">
            <div class="pie__grid">
                <div>
                    <p class="pie__marca">R. H.<br /><em>Enricci</em></p>
                    <p class="texto-suave" style="max-width:34ch">
                        Inmobiliaria de barrio con oficina propia en Monserrat desde @SitioInfo.AnioFundacion.
                        Compra, venta, alquiler y administración de propiedades en la Ciudad de Buenos Aires.
                    </p>
                    <div class="redes">
                        <a href="@SitioInfo.WhatsappGeneral" target="_blank" rel="noopener" aria-label="Escribirnos por WhatsApp">
                            <svg aria-hidden="true"><use href="#i-wsp" /></svg>
                        </a>
                        <a href="@SitioInfo.Instagram" target="_blank" rel="noopener" aria-label="Instagram">
                            <svg aria-hidden="true"><use href="#i-instagram" /></svg>
                        </a>
                        @if (!string.IsNullOrEmpty(SitioInfo.Facebook))
                        {
                            <a href="@SitioInfo.Facebook" target="_blank" rel="noopener" aria-label="Facebook">
                                <svg aria-hidden="true"><use href="#i-facebook" /></svg>
                            </a>
                        }
                        <a href="@SitioInfo.MailA("Consulta desde la web")" aria-label="Enviarnos un correo">
                            <svg aria-hidden="true"><use href="#i-mail" /></svg>
                        </a>
                    </div>
                </div>

                <div>
                    <h4>Propiedades</h4>
                    <ul>
                        <li><a asp-page="/Propiedades" asp-route-operacion="Venta">En venta</a></li>
                        <li><a asp-page="/Propiedades" asp-route-operacion="Alquiler">En alquiler</a></li>
                        <li><a asp-page="/Propiedades" asp-route-operacion="AlquilerTemporario">Temporario</a></li>
                        <li><a asp-page="/Propiedades" asp-route-tipo="LocalComercial">Locales</a></li>
                        <li><a asp-page="/Propiedades" asp-route-tipo="Cochera">Cocheras</a></li>
                    </ul>
                </div>

                <div>
                    <h4>Servicios</h4>
                    <ul>
                        <li><a asp-page="/Tasacion">Tasación</a></li>
                        <li><a asp-page="/Cobranza">Administración y cobranza</a></li>
                        <li><a asp-page="/Asesoria_Legal">Asesoría legal</a></li>
                        <li><a asp-page="/Servicios">Todos los servicios</a></li>
                        <li><a asp-page="/Quienes_Somos">Quiénes somos</a></li>
                    </ul>
                </div>

                <div>
                    <h4>Contacto</h4>
                    <ul>
                        <li><a href="@SitioInfo.TelefonoLink">@SitioInfo.Telefono</a></li>
                        <li><a href="@SitioInfo.WhatsappGeneral" target="_blank" rel="noopener">WhatsApp @SitioInfo.Celular</a></li>
                        <li><a href="@SitioInfo.MailA("Consulta desde la web")">@SitioInfo.Email</a></li>
                        <li>@SitioInfo.DireccionCompleta, @SitioInfo.Localidad</li>
                        <li>@SitioInfo.Horario</li>
                    </ul>
                </div>
            </div>

            <div class="pie__legal">
                <span>&copy; <span data-anio>2026</span> @SitioInfo.Nombre. Todos los derechos reservados.</span>
                <span>
                    @SitioInfo.Matricula
                    <a asp-page="/Privacidad">Política de privacidad</a>
                    <a class="pie__panel" asp-page="/Admin/Index" rel="nofollow">Administrar</a>
                </span>
            </div>
        </div>
    </footer>

    <a class="wsp-flotante" href="@SitioInfo.WhatsappGeneral" target="_blank" rel="noopener">
        <svg aria-hidden="true"><use href="#i-wsp" /></svg>
        <span>Escribinos</span>
    </a>

    <script src="~/js/enricci.js" asp-append-version="true"></script>
    <partial name="_Analitica" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
